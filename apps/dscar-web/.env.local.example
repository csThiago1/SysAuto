# ─────────────────────────────────────────────────────────────────────────────
# dscar-web — .env.local.example
# Copie para .env.local e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── next-auth v5 ────────────────────────────────────────────────────────────
# URL publica do app. Dev: http://localhost:3001 | Prod: https://dscar.paddock.solutions
NEXTAUTH_URL=http://localhost:3001

# Gere com: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# ── Tenant padrao ───────────────────────────────────────────────────────────
DEFAULT_TENANT_DOMAIN=dscar.localhost

# ── API Django (backend) ────────────────────────────────────────────────────
# Dev: http://localhost:8000 | Prod: https://api.paddock.solutions
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sentry (opcional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Cloudflare R2 (media em staging/prod) ───────────────────────────────────
R2_PUBLIC_URL=
