# ─────────────────────────────────────────────────────────────────────────────
# dscar-web — .env.local.example
# Copie para .env.local e preencha os valores.
# ─────────────────────────────────────────────────────────────────────────────

# ── next-auth v5 ────────────────────────────────────────────────────────────
# URL publica do app. Dev: http://localhost:3001 | Prod: https://dscar.paddock.solutions
NEXTAUTH_URL=http://localhost:3001

# Gere com: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=

# ── Tenant padrao ───────────────────────────────────────────────────────────
DEFAULT_TENANT_DOMAIN=dscar.localhost

# ── API Django (backend) ────────────────────────────────────────────────────
# Dev: http://localhost:8000 | Prod: https://api.paddock.solutions
NEXT_PUBLIC_API_URL=http://localhost:8000
# URL interna do backend (server-side only, usada pelo proxy e SSR)
# Se diferente de NEXT_PUBLIC_API_URL (ex: rede interna Docker/Vercel)
BACKEND_URL=
# Mesmo valor do PROXY_SHARED_SECRET do Django: libera o IP do cliente na assinatura
PROXY_SHARED_SECRET=

# ── Tempo real (opcional, só no ambiente local) ─────────────────────────────
# Liga o websocket do tempo real. Precisa do serviço `ws` do docker-compose.dev (porta 8001).
# Deixe ausente na Vercel/producao: sem ele o app nao abre websocket.
# NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8001/ws/realtime/

# ── Sentry (opcional) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Cloudflare R2 (media em staging/prod) ───────────────────────────────────
R2_PUBLIC_URL=
