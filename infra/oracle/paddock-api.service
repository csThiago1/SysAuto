# /etc/systemd/system/paddock-api.service
# ponytail: bare-metal na E2.1.Micro (500MB) — containers não cabem;
# ao migrar pra VM A1, voltar pro docker-compose.yml deste diretório.
[Unit]
Description=Paddock DS Car API (gunicorn)
After=network-online.target redis.service
Wants=network-online.target

[Service]
User=opc
WorkingDirectory=/opt/paddock
EnvironmentFile=/opt/paddock/.env
# --threads 2: o trabalho é espera de banco (Neon); 2 workers sync atendiam só
# 2 requests por vez e o dashboard no celular dispara 5+. 2 (não 4) até medir o
# RSS: ZIP de fotos/PDF em paralelo podem estourar o MemoryMax=350M e o OOM
# derruba todas as requests do worker. max-requests maior = menos reboot.
ExecStart=/opt/paddock/venv/bin/gunicorn config.wsgi:application \
  --bind 127.0.0.1:8000 --workers 2 --threads 2 --timeout 60 \
  --max-requests 2000 --max-requests-jitter 100
Restart=always
RestartSec=5
MemoryMax=350M

[Install]
WantedBy=multi-user.target
