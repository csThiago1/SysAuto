# ─────────────────────────────────────────────────────────────────────────────
# Paddock ERP — .env.example
# Copie para .env e preencha os valores.
# NUNCA versione o .env real (ja esta no .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Banco de dados ──────────────────────────────────────────────────────────
DB_NAME=paddock_dev
DB_USER=paddock
DB_PASSWORD=paddock
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_LAYERS_URL=redis://redis:6379/2

# ─── Django ──────────────────────────────────────────────────────────────────
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE-ME-generate-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,0.0.0.0

# ─── Criptografia (LGPD) — django-encrypted-model-fields ────────────────────
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE-ME-generate-a-fernet-key

# ─── JWT Authentication (auth nativo) ───────────────────────────────────────
# Dev: usa HS256 com DEV_JWT_SECRET (abaixo)
# Prod: gere par RS256: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Cole o conteudo dos .pem aqui (com \n para quebras de linha)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DEV_JWT_SECRET=dscar-dev-secret-paddock-2025

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Cadastre em resend.com e pegue a API key
RESEND_API_KEY=
EMAIL_FROM=noreply@paddock.solutions
FRONTEND_URL=http://localhost:3001

# ─── IA — Claude API ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Fiscal (Focus NF-e) ────────────────────────────────────────────────────
SEFAZ_ENV=homologacao
DSCAR_CNPJ=10362513000104
DSCAR_CERT_PATH=/certs/dscar.pfx
DSCAR_CERT_PASSWORD=
FOCUSNFE_TOKEN=
FOCUS_NFE_AMBIENTE=homologacao
FOCUS_NFE_WEBHOOK_SECRET=

# ─── Storage (AWS S3 ou Cloudflare R2) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_S3_BUCKET=paddock-dev-storage

# Cloudflare R2 (homolog/staging)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Sentry ─────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── API Placas (wdapi2.com.br) ─────────────────────────────────────────────
APIPLACAS_TOKEN=

# ─── Cilia Web Service ──────────────────────────────────────────────────────
CILIA_BASE_URL=https://sistema.cilia.com.br
CILIA_AUTH_TOKEN=

# ─── WhatsApp (Evolution API) — fora do MVP ─────────────────────────────────
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=dscar
